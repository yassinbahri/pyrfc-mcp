# Copy to .env and fill in. Even placeholder values let `mcp dev` build the
# server and list tool schemas with zero SAP connectivity — real values are
# only needed once you actually invoke a tool.

# --- Connection addressing: choose ONE mode ---
# Mode 1: direct application server
RFC_MCP_SAP_ASHOST=sap-test.example.com
RFC_MCP_SAP_SYSNR=00

# Mode 2: load-balanced via message server (leave ASHOST/SYSNR unset instead)
# RFC_MCP_SAP_MSHOST=sap-msg.example.com
# RFC_MCP_SAP_MSSERV=sapmsXX
# RFC_MCP_SAP_GROUP=PUBLIC
# RFC_MCP_SAP_R3NAME=XXX

RFC_MCP_SAP_CLIENT=100
RFC_MCP_SAP_USER=RFC_MCP_USER
RFC_MCP_SAP_PASSWD=changeme
RFC_MCP_SAP_LANG=EN

RFC_MCP_SAP_POOL_SIZE=4
RFC_MCP_SAP_POOL_ACQUIRE_TIMEOUT_SECONDS=30
RFC_MCP_SAP_MAX_RETRIES=3
RFC_MCP_SAP_BACKOFF_BASE_SECONDS=0.5

# --- Execution policy ---
# read_only (default) or read_write. Leave as read_only for a dev system
# where nothing should ever be changed: mode="write" calls and
# commit_rfc_transaction/rollback_rfc_transaction are unconditionally
# blocked whenever mode is read_only, regardless of any patterns below.
RFC_MCP_POLICY_MODE=read_only
# JSON arrays of glob patterns (case-insensitive), matched against function names.
# Deny-by-default. Add only the functions/function groups the service account
# is intended to expose. These examples support discovery and the smoke test.
RFC_MCP_POLICY_READ_ALLOW_PATTERNS=["RFC_FUNCTION_SEARCH","RFC_GET_FUNCTION_INTERFACE","RFC_GET_STRUCTURE_DEFINITION","RPY_PROGRAM_READ","RPY_FUNCTIONMODULE_READ","STFC_CONNECTION"]
RFC_MCP_POLICY_WRITE_ALLOW_PATTERNS=[]

# deny_patterns applies to BOTH read and write calls — it's the guardrail
# against a caller mislabeling a mutating function as mode="read". Leave
# RFC_MCP_POLICY_DENY_PATTERNS unset (don't uncomment the line below) to
# keep the built-in default from rfc_mcp.config.DEFAULT_DENY_PATTERNS, which
# blocks common mutating-verb names (*_CREATE*, *_CHANGE*, *_DELETE*, etc.)
# plus a few explicitly dangerous functions (RFC_ABAP_INSTALL_AND_RUN,
# BAPI_TRANSACTION_COMMIT/ROLLBACK, SUSR_*) even in read_only mode. This is
# a heuristic, not a guarantee — pair it with SAP-side S_RFC authorization
# scoped to only the function groups you intend to expose (see
# docs/setup.md). Setting this env var at all REPLACES the default list
# entirely, so only uncomment it if you're deliberately supplying your own
# full list.
# RFC_MCP_POLICY_DENY_PATTERNS=[]

# table_deny_patterns is a SEPARATE guard from deny_patterns above, for
# generic table-reader functions (RFC_READ_TABLE and known clones — see
# rfc_mcp.config.GENERIC_TABLE_READER_FUNCTIONS). deny_patterns matches on
# the FUNCTION name; RFC_READ_TABLE's own name never matches a mutating-verb
# pattern, since it reads whatever table is named in its QUERY_TABLE
# parameter instead — so without this, mode="read" could dump USR02,
# AGR_USERS, UST04, or any other table the RFC user's SAP-side authorization
# permits. Leave RFC_MCP_POLICY_TABLE_DENY_PATTERNS unset to keep the
# built-in default (rfc_mcp.config.DEFAULT_SENSITIVE_TABLE_PATTERNS: USR*,
# AGR_*, UST04, DEVACCESS, RFCDES, etc.) — same caveat as above: a heuristic
# list, not a substitute for SAP-side S_TABU_DIS/S_TABU_NAM authorization.
# Setting this env var at all REPLACES the default list entirely.
# RFC_MCP_POLICY_TABLE_DENY_PATTERNS=[]

# --- App ---
RFC_MCP_LOG_LEVEL=INFO
RFC_MCP_DISCOVERY_CACHE_TTL_SECONDS=300
RFC_MCP_STRUCTURE_RESOLUTION_MAX_DEPTH=8
# Abandoned write transactions are rolled back after this idle period.
RFC_MCP_TRANSACTION_TTL_SECONDS=300

# RFC responses are rejected, never silently truncated, when their nested
# table rows or compact UTF-8 JSON representation exceed these boundaries.
# These limits protect MCP consumers and model context. They cannot reduce
# work that the RFC function has already performed inside SAP.
RFC_MCP_RESULT_MAX_TABLE_ROWS=10000
RFC_MCP_RESULT_MAX_SERIALIZED_BYTES=1048576

# --- ADT (optional, read-only inspection plane — see
# docs/adt_rfc_integration_plan.md) ---
# Disabled by default and safe to leave that way: RFC_MCP_ADT_ENABLED=false
# needs nothing else set below, and the read_abap_source tool just uses its
# RFC fallback path (RPY_PROGRAM_READ/RPY_FUNCTIONMODULE_READ) transparently
# instead — there's no error, no degraded behavior a caller needs to handle.
# ADT is a SEPARATE service from RFC — SAP's ADT REST API, normally reached
# over HTTP(S) on the ICM port (commonly 8000+<sysnr> / 44300+<sysnr>), not
# the RFC gateway port. It must be activated in SICF on the SAP side before
# this can ever succeed — see the plan doc's "Status" note for what that
# checklist actually looks like and what we found trying it against a real
# system.
RFC_MCP_ADT_ENABLED=false
# RFC_MCP_ADT_HOST=sap-test.example.com
# RFC_MCP_ADT_PORT=44300
# RFC_MCP_ADT_USE_SSL=true
# RFC_MCP_ADT_VERIFY_SSL=true
# RFC_MCP_ADT_CLIENT=100
# RFC_MCP_ADT_USER=RFC_MCP_USER
# RFC_MCP_ADT_PASSWD=changeme
